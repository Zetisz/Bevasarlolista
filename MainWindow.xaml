<Window x:Class="Bevasarlolista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bevasarlolista"
        mc:Ignorable="d"
        Title="Bevásárlólista" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="lb" Grid.Column="0" FontSize="25" Background="Azure"></ListBox>
        <TextBox x:Name="tb" Grid.Column="1" Width="300" Height="40" FontSize="30" KeyDown="tb_KeyDown" HorizontalAlignment="Left"></TextBox>
        <Button x:Name="btnHozzadas" Grid.Column="1" Width="90" Height="40" HorizontalAlignment="Right" Click="btnHozzadas_Click">Hozzáaadás</Button>
        <Button Grid.Column="1" Width="180" Height="40" Margin="0, 100, 200, 0" Click="btnTorles_Click">Törlés</Button>
        <Button Grid.Column="1" Width="180" Height="40" Margin="200, 100, 0, 0" Click="btnMindentTorles_Click" >Mindent töröl</Button>
        <Label x:Name="lblCounter" Grid.Column="1" Content="0" Width="200" Height="60" VerticalAlignment="Bottom" Margin="0, 0, 0, 50" FontSize="40" HorizontalContentAlignment="Center"></Label>
    </Grid>
</Window>
